# 需要手动设置的两个变量：

# 登录密码（自定义，越长越好）
APP_PASSWORD=请改成你的密码

# 会话签名密钥（随机长字符串，可用：openssl rand -base64 32）
SESSION_SECRET=请改成一段随机字符串

# Redis 连接变量由 Vercel 的 Upstash 集成自动注入，无需手动设置：
#   KV_REST_API_URL / KV_REST_API_TOKEN
# （代码也兼容 UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN）

# === Web Push（到站提醒）===
# 用 `npx web-push generate-vapid-keys` 生成
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:rylen@digiplus.com.ph"

# === QStash（到点定时回调）===
QSTASH_TOKEN=""

# fire 回调共享密钥（任意长随机串，如 `openssl rand -hex 32`）
PUSH_FIRE_SECRET=""

# QStash 回调用的公开站点地址（生产域名，含协议）。Vercel 上未设时回退到 https://$VERCEL_URL
PUBLIC_BASE_URL="https://timebank.hr1x.xyz"
